+  );
+  assert.deepEqual(refs('{ "references": [{ "path": "./a" }] } // trailing'), [
+    "./a",
+  ]);
+  assert.deepEqual(refs('{ "references": [{ "path": "./a" },] }'), ["./a"]); // trailing comma
+  assert.deepEqual(refs('{ "files": [] }'), []); // no references
