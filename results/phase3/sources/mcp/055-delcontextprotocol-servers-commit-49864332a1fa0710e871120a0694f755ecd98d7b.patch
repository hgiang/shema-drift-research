From 49864332a1fa0710e871120a0694f755ecd98d7b Mon Sep 17 00:00:00 2001
From: cliffhall <cliff@futurescale.com>
Date: Tue, 29 Sep 2026 01:20:08 -0400
Subject: [PATCH] fix: repository-level paths in the forms; absolute policy
 link in the PR template

The bug form offered a repository-level choice but then required server
facts with no way to answer them truthfully; split the choice from
"more than one server" and add a not-applicable option to each required
server-specific dropdown. The feature form's acknowledgement now allows
repository-level requests. The PR template's CONTRIBUTING.md link was
relative, which breaks once the template is copied into a PR body; it is
now absolute. (Copilot, round 1.)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Signed-off-by: cliffhall <cliff@futurescale.com>
---
 .github/ISSUE_TEMPLATE/1-bug_report.yml      | 12 +++++++++---
 .github/ISSUE_TEMPLATE/2-feature_request.yml |  5 +++--
 .github/pull_request_template.md             |  6 +++---
 3 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/.github/ISSUE_TEMPLATE/1-bug_report.yml b/.github/ISSUE_TEMPLATE/1-bug_report.yml
index 7a75c4773f..dea4fa2e7a 100644
--- a/.github/ISSUE_TEMPLATE/1-bug_report.yml
+++ b/.github/ISSUE_TEMPLATE/1-bug_report.yml
@@ -45,7 +45,8 @@ body:
         - fetch (mcp-server-fetch)
         - git (mcp-server-git)
         - time (mcp-server-time)
-        - More than one, or the repository itself
+        - More than one server
+        - The repository itself (CI, docs, templates, release tooling)
     validations:
       required: true
 
@@ -55,7 +56,7 @@ body:
       label: Server version
       description: >
         The version you actually ran, not "latest". For an unreleased build,
-        give the commit.
+        give the commit. For a repository-level report, write n/a.
       placeholder: "0.6.3"
     validations:
       required: true
@@ -70,6 +71,7 @@ body:
         - Docker image
         - From a clone of this repository
         - Other (say which below)
+        - Not applicable (a repository-level report)
     validations:
       required: true
 
@@ -85,6 +87,7 @@ body:
         - Streamable HTTP
         - HTTP+SSE (deprecated)
         - Not sure
+        - Not applicable (a repository-level report)
     validations:
       required: true
 
@@ -101,6 +104,7 @@ body:
         - Modern (2026-07-28)
         - Legacy (2025-11-25 or earlier)
         - Not sure
+        - Not applicable (a repository-level report)
     validations:
       required: true
 
@@ -108,7 +112,9 @@ body:
     id: client
     attributes:
       label: MCP client and version
-      description: The client that talked to the server, with its version.
+      description: >
+        The client that talked to the server, with its version. For a
+        repository-level report, write n/a.
       placeholder: "Claude Desktop 1.2.3, MCP Inspector 2.0.0, a custom SDK client"
     validations:
       required: true
diff --git a/.github/ISSUE_TEMPLATE/2-feature_request.yml b/.github/ISSUE_TEMPLATE/2-feature_request.yml
index 1780141df0..32ca5fe830 100644
--- a/.github/ISSUE_TEMPLATE/2-feature_request.yml
+++ b/.github/ISSUE_TEMPLATE/2-feature_request.yml
@@ -44,7 +44,8 @@ body:
         - fetch (mcp-server-fetch)
         - git (mcp-server-git)
         - time (mcp-server-time)
-        - More than one, or the repository itself
+        - More than one server
+        - The repository itself (CI, docs, templates, release tooling)
     validations:
       required: true
 
@@ -130,5 +131,5 @@ body:
       options:
         - label: I searched existing issues and this is not a duplicate.
           required: true
-        - label: This is a request for one of the servers in this repository, not a new server, the MCP specification or an SDK.
+        - label: This is a request for this repository or one of its servers, not a new server, the MCP specification or an SDK.
           required: true
diff --git a/.github/pull_request_template.md b/.github/pull_request_template.md
index 84ccc325fd..0fdbc59826 100644
--- a/.github/pull_request_template.md
+++ b/.github/pull_request_template.md
@@ -21,8 +21,8 @@
     → Publish it to the MCP Server Registry instead
       (https://github.com/modelcontextprotocol/registry).
 
-  Full policy: ../CONTRIBUTING.md (relative to this template; the file lives
-  at the repository root, on whatever branch you're reading).
+  Full policy:
+  https://github.com/modelcontextprotocol/servers/blob/main/CONTRIBUTING.md
 
   Maintainers: delete this comment and the banner below, keep the first line
   as `Closes #<ISSUE_NUMBER>`, and fill in the sections.
@@ -30,7 +30,7 @@
 
 > **Heads up:** this repository accepts **issues, not pull requests**, from
 > anyone but the repository maintainers. Please read
-> [`CONTRIBUTING.md`](../CONTRIBUTING.md) before continuing. If you're not a
+> [`CONTRIBUTING.md`](https://github.com/modelcontextprotocol/servers/blob/main/CONTRIBUTING.md) before continuing. If you're not a
 > maintainer, open an issue (and share the prompt you used, if you've already
 > built the change) rather than this PR. To make a server discoverable, publish
 > it to the [MCP Server Registry](https://github.com/modelcontextprotocol/registry).
