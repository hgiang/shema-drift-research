+        type: z.enum(["image", "audio", "blob"]),
         data: z.string(),
         mimeType: z.string()
       }))
@@ -278,17 +275,15 @@ server.registerTool(
     const mimeType = mimeTypes[extension] || "application/octet-stream";
     const data = await readFileAsBase64Stream(validPath);
 
