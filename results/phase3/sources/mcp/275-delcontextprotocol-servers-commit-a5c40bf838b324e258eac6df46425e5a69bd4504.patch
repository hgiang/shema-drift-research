+      queueMicrotask(() => c.emit("close", 0));
+      return c;
+    },
+    platform: "linux",
+  }).catch(() => {});
+  assert.equal(seen.command, "claude");
+  assert.ok(!seen.args.includes(prompt), "prompt must not appear in argv");
+  assert.deepEqual(seen.options.stdio, ["pipe", "pipe", "inherit"]);
